{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>graphcal-lang/renovate-config"],
  // Keep transitive deps (e.g. @codemirror/state) from resolving to a stale duplicate after an update.
  postUpdateOptions: ["pnpmDedupe"],
  customManagers: [
    {
      customType: "regex",
      description: "Update Cargo tools installed by taiki-e/install-action",
      managerFilePatterns: ["/^\\.github\\/workflows\\/.*\\.ya?ml$/"],
      matchStrings: [
        "tool:\\s*(?<depName>cargo-[\\w-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "crate",
    },
    {
      customType: "regex",
      description: "Update Zensical used to build the documentation",
      managerFilePatterns: ["/^\\.github\\/workflows\\/docs\\.yaml$/"],
      matchStrings: [
        "pip install (?<depName>zensical)==(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "pypi",
    },
    {
      customType: "regex",
      description: "Update the pinned qa-corpus commit checked out by CI",
      managerFilePatterns: ["/^\\.github\\/workflows\\/ci\\.yaml$/"],
      matchStrings: [
        "repository: graphcal-lang/qa-corpus\\n(?:\\s*#.*\\n)*\\s*ref: (?<currentDigest>[0-9a-f]{40}) # renovate: branch=(?<currentValue>\\S+)",
      ],
      depNameTemplate: "graphcal-lang/qa-corpus",
      packageNameTemplate: "https://github.com/graphcal-lang/qa-corpus",
      datasourceTemplate: "git-refs",
    },
  ],
  packageRules: [
    {
      description: "Hold num-bigint at 0.4 until num-rational supports 0.5 (rust-num/num-rational#157)",
      matchManagers: ["cargo"],
      matchPackageNames: ["num-bigint"],
      allowedVersions: "<0.5",
    },
    {
      matchManagers: ["rust-toolchain"],
      matchDepTypes: ["toolchain"],
      addLabels: ["rust", "ci"],
    },
  ],
}
