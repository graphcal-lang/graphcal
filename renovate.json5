{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  minimumReleaseAge: "7 days",
  // Keep transitive deps (e.g. @codemirror/state) from resolving to a stale duplicate after an update.
  postUpdateOptions: ["pnpmDedupe"],
  lockFileMaintenance: {
    enabled: true,
  },
  customManagers: [
    {
      customType: "regex",
      description: "Track the gh-actions-lock version used to verify the actions lockfile",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ["gh extension install github/gh-actions-lock --pin (?<currentValue>v[^\\s]+)"],
      depNameTemplate: "github/gh-actions-lock",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update Cargo tools installed by taiki-e/install-action",
      managerFilePatterns: ["/^\\.github\\/workflows\\/.*\\.ya?ml$/"],
      matchStrings: [
        "tool:\\s*(?<depName>cargo-[\\w-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "crate",
    },
    {
      customType: "regex",
      description: "Update Zensical used to build the documentation",
      managerFilePatterns: ["/^\\.github\\/workflows\\/docs\\.yaml$/"],
      matchStrings: [
        "pip install (?<depName>zensical)==(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "pypi",
    },
  ],
  packageRules: [
    {
      // .github/workflows/actions.lock pins action commits; gh actions-lock strips inline digests.
      description: "Use the actions lockfile instead of inline digest pins",
      matchManagers: ["github-actions"],
      pinDigests: false,
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
    {
      description: "Disable Renovate cooldown for Cargo crates until Cargo min-publish-age is stable (#885)",
      matchManagers: ["cargo"],
      matchDatasources: ["crate"],
      minimumReleaseAge: null,
    },
    {
      matchManagers: ["rust-toolchain"],
      matchDepTypes: ["toolchain"],
      addLabels: ["rust", "ci"],
    },
  ],
}
