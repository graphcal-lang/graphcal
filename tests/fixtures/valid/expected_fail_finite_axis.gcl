// Per-key `#[expected_fail]` on assertions indexed by Fin axes uses `#N`
// keys, matching the `#N` slice-label syntax of `table` expressions.
#[expected_fail(#1)]
assert single_finite = for i: Fin(2) { to_int(i) == 0 };

index Mode = { Boost, Cruise };

// Mixed tuple keys: named axes use `Index.Variant`, Fin axes use `#N`,
// in assertion axis order.
#[expected_fail((Mode.Boost, #1))]
assert mixed = for m: Mode {
    for i: Fin(2) {
        match m {
            Mode.Boost => if to_int(i) == 1 { false } else { true },
            Mode.Cruise => true,
        }
    }
};
