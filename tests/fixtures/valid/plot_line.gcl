// plot_line.gcl -- Line chart with coordinate index
//
// Demonstrates a line chart using an exact-step coordinate index for time-series data,
// showing exponential decay over discrete time steps.
pub index TimeStep = range(0.0 s, 2.0 s, step: 0.5 s);

param decay_rate: Frequency = 1.0 Hz;
param initial_value: Dimensionless = 10.0;

node y: Dimensionless[TimeStep] = unfold(
    TimeStep,
    @initial_value,
    |prev_y, prev_t, t| prev_y * (1.0 - @decay_rate * (t - prev_t))
);

plot decay_curve = {
    mark: line,
    encode: {
        x: for t: TimeStep { t },
        y: for t: TimeStep { @y[t] },
    },
    title: "Exponential Decay",
    x_label: "Time",
    y_label: "Value",
};
