// range_index.gcl -- Exact-step coordinate index and unfold
// A coordinate index with time dimension
pub index TimeStep = range(0.0 s, 1.0 s, step: 0.5 s);

// Growth rate (1/s)
param rate: Frequency = 0.5 Hz;

// Initial value
param x0: Dimensionless = 1.0;

// Exponential growth: x(t+dt) = x(t) * (1 + rate * dt)
node x: Dimensionless[TimeStep] = unfold(
    TimeStep,
    @x0,
    |prev_x, prev_t, t| prev_x * (1.0 + @rate * (coord(t) - coord(prev_t)))
);
