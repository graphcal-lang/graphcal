// Comparison operators require unindexed operands. Use an explicit `for`
// comprehension to compare indexed values one element at a time.
index Case = { A, B };

node actual: Length[Case] = {
    Case#A: 1.0 m,
    Case#B: 2.0 m,
};
node expected: Length[Case] = {
    Case#A: 1.0 m,
    Case#B: 2.5 m,
};

node same: Bool[Case] = for case: Case { @actual[case] == @expected[case] };
node below: Bool[Case] = for case: Case { @actual[case] < 3.0 m };

// Indexed Boolean assertions also use an explicit comprehension.
assert all_below = for case: Case { @actual[case] < 3.0 m };
assert none_above = for case: Case { 0.0 m < @actual[case] };
