// A required discrete index port accepts a structural Fin(N) axis directly.
dag scale {
    pub(bind) index Axis;
    param xs: Dimensionless[Axis];
    pub node ys: Dimensionless[Axis] = for i: Axis { @xs[i] * 2.0 };
}

include scale(
    index Axis: Fin(1 + 2),
    xs: table[Fin(3)] {
        1.0;
        2.0;
        3.0;
    }
) as scaled;

node out: Dimensionless[Fin(3)] = @scaled::ys;
