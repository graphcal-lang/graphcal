// Test from_unix and to_unix on UTC datetimes
param t: Datetime = datetime("2024-11-05T12:00:00Z");

// Roundtrip: to_unix -> from_unix
node unix_ts: Dimensionless = to_unix(@t);
node t_from_unix: Datetime = from_unix(@unix_ts);
assert unix_roundtrip = @t_from_unix == @t;

// Known values:
// 2024-11-05T12:00:00 UTC Unix timestamp = 1730808000
assert unix_value = @unix_ts == 1730808000.0;

// Another scale is converted to UTC explicitly first.
node tt_unix: Dimensionless = to_unix(to_utc(epoch<TT>("2024-11-05T12:01:09.184")));
assert tt_unix_value = @tt_unix == 1730808000.0;
