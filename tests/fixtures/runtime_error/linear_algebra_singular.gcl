// Singular systems fail explicitly instead of producing NaN or infinity.
param singular: Dimensionless[Fin(2), Fin(2)] = table[Fin(2), Fin(2)] {
    1.0, 2.0;
    2.0, 4.0;
};
param rhs: Dimensionless[Fin(2)] = table[Fin(2)] {
    1.0;
    2.0;
};
node no_unique_solution: Dimensionless[Fin(2)] = solve(@singular, @rhs);
