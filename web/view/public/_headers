# HTTP response headers of https://view.graphcal.org/ (Cloudflare Workers static
# assets, web/view-deploy/wrangler.jsonc). They apply only to responses served
# from the assets, so the view must stay a Worker without a script.
#
# The page talks to its own origin only (GitHub is read through the browser
# extension, by messaging, not by fetch), runs its own scripts and the WASM
# engine, submits no form, loads no third-party resource, and is never framed.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=()
  Strict-Transport-Security: max-age=31536000

# Vite names these by their content hash.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
