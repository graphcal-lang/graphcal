{
  "name": "view",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "fixtures": "node fixtures/export.mjs && vp fmt fixtures",
    "engine": "wasm-pack build ../../crates/graphcal-wasm --target web --out-dir ../../web/view/public/pkg --profile wasm-release --no-typescript --no-pack"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  }
}
