node heat_dcdc: Power[Component] = for c: Component {
    @p_nominal[c] / @eta_dcdc[c] - @p_nominal[c]
};

node p_unit_nominal: Power[Component] = for c: Component {
    to_float(@num[c]) * @p_nominal[c] * (1.0 + @margin[c]) / @eta_dcdc[c]
};

node p_unit_max: Power[Component] = for c: Component {
    to_float(@num[c]) * @p_max[c] * (1.0 + @margin[c]) / @eta_dcdc[c]
};

node p_mode_nominal: Power[Mode] = for m: Mode {
    sum(for c: Component { if @on[c, m] { @p_unit_nominal[c] } else { 0.0 W } })
};

node p_mode_max: Power[Mode] = for m: Mode {
    sum(for c: Component { if @on[c, m] { @p_unit_max[c] } else { 0.0 W } })
};

pub node p_peak: Power = maximum(@p_mode_max);
pub node heat_total: Power = sum(@heat_dcdc);
pub node worst_mode: Key<Mode> = argmax(@p_mode_max);

assert within_budget = @p_peak <= @p_budget;
