// CAN A FASTER SIGNAL LOOK SLOWER?
// Orange is a low-frequency explanation of exactly the same black samples.
// 1. With sampling_rate = 10 Hz, compare signal_frequency = 1 Hz and 9 Hz.
// 2. Increase the signal from 6 Hz to 9 Hz: its alias SLOWS from 4 Hz to 1 Hz.
// 3. Set signal_frequency = 10 Hz: a moving signal appears completely constant!
// 4. Raise sampling_rate to 25 Hz to distinguish the original 9 Hz signal.
// Model: ideal instantaneous, uniformly spaced samples of a zero-phase cosine.
// The alias is one possible explanation, NOT recovery of the original signal.
// The window always contains 21 samples, so changing sampling rate changes duration.
param signal_frequency: Frequency(min: 0.0 Hz, max: 25.0 Hz) = 9.0 Hz;
param sampling_rate: Frequency(min: 2.0 Hz, max: 50.0 Hz) = 10.0 Hz;
param amplitude: Length(min: 0.1 mm, max: 10.0 mm) = 1.0 mm;

index Wave = { ActualSignal, LowFrequencyAlias };
index Fine = linspace(0.0, 1.0, points: 2001);
index FrequencySweep = linspace(0.0 Hz, 25.0 Hz, points: 501);
node alias_frequency: Frequency = abs(
    @signal_frequency - round(@signal_frequency / @sampling_rate) * @sampling_rate
);
node nyquist_frequency: Frequency = @sampling_rate / 2.0;
node window: Time = 20.0 / @sampling_rate;
node frequencies: Frequency[Wave] = {
    Wave#ActualSignal: @signal_frequency,
    Wave#LowFrequencyAlias: @alias_frequency,
};
node sample_time: Time[Fin(21)] = for i: Fin(21) { to_float(to_int(i)) / @sampling_rate };
node sample_value: Length[Fin(21)] = for i: Fin(21) {
    @amplitude * cos(TAU * @signal_frequency * @sample_time[i] * 1.0 rad)
};
node sample_disagreement: Length = maximum(
    for i: Fin(21) {
        abs(@sample_value[i] - @amplitude * cos(TAU * @alias_frequency * @sample_time[i] * 1.0 rad))
    }
);
assert same_samples = @sample_disagreement < 0.000001 mm;

#[hidden]
plot possible_signals = {
    mark: line {
        stroke_width: 2.0,
        opacity: 0.75,
    },
    encode: {
        x: for t: Fine { coord(t) * @window -> s },
        y: for wave: Wave, t: Fine {
            @amplitude * cos(TAU * @frequencies[wave] * coord(t) * @window * 1.0 rad) -> mm
        },
        color: for wave: Wave { wave },
    },
    x_label: "Time (s)",
    y_label: "Displacement (mm)",
};
#[hidden]
plot observed_samples = {
    mark: point {
        color: "black",
        stroke_width: 2.5,
        size: 70.0,
    },
    encode: {
        x: for i: Fin(21) { @sample_time[i] -> s },
        y: for i: Fin(21) { @sample_value[i] -> mm },
    },
};
layer indistinguishable = {
    plots: [possible_signals, observed_samples],
    title: "Two different signals pass through every black sample",
    width: 620.0,
    height: 280.0,
};
#[hidden]
plot folding = {
    mark: line {
        stroke_width: 2.0,
    },
    encode: {
        x: for f: FrequencySweep { coord(f) -> Hz },
        y: for f: FrequencySweep {
            abs(coord(f) - round(coord(f) / @sampling_rate) * @sampling_rate) -> Hz
        },
    },
    x_label: "Actual frequency (Hz)",
    y_label: "Apparent low frequency (Hz)",
};
#[hidden]
plot current_frequency = {
    mark: point {
        color: "#e45756",
        stroke_width: 3.0,
        size: 150.0,
    },
    encode: {
        x: @signal_frequency -> Hz,
        y: @alias_frequency -> Hz,
    },
};
layer frequency_folding = {
    plots: [folding, current_frequency],
    title: "Follow the dot: faster can look slower",
    width: 620.0,
    height: 220.0,
};
